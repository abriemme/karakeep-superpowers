# Copy to `.env` and fill in. `.env` is git-ignored and auto-loaded by
# app/config.py (existing shell/CI variables take precedence).

# --- Temporal ----------------------------------------------------------------
# Local dev server started with `temporal server start-dev`.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Karakeep (required) -----------------------------------------------------
KARAKEEP_URL=https://karakeep.example.com
KARAKEEP_TOKEN=
# Optional list added to every bookmark, on top of the classified ones.
KARAKEEP_LIST_ID=

# --- LLM enrichment (required) -----------------------------------------------
OPENAI_API_KEY=
# ENRICH_MODEL=openai:gpt-5-mini

# --- State / session ---------------------------------------------------------
# instagrapi session.json, seen.json (dedup), collections.json cache.
DATA_DIR=./data

# --- Optional tuning (defaults shown; see README for the full table) ---------
# MAX_ITEMS=40
# MAX_PAGES=25
# ASSET_TYPES=banner,screenshot,carousel
# MAX_CAROUSEL=10
# MAX_ASSET_MB=50
# REPLACE_BANNER=1
# AUTO_TAGS=hashtags,author,type,music,location
# MAX_TAGS=12
# HASHTAG_SPAM_THRESHOLD=20
# SYNC_COLLECTIONS=1
# CREATE_MISSING_LISTS=0
# COLLECTION_SCAN=60
# COLLECTION_CACHE_HOURS=24

# --- Observability (optional) ------------------------------------------------
# LOGFIRE_TOKEN=
